(version 1)

    # 1. ІМПЕДАНС 50 Ом Single-Ended (DQ, SDQM, ADDR, CMD/CTRL)
    (rule "DDR3_DATA_50_OHM_OUTER"
        (layer outer)
        (condition "A.NetClass == 'DDR3_DATA_LB' || A.NetClass == 'DDR3_DATA_HB'")
        (constraint track_width (min 0.0900mm) (opt 0.1072mm) (max 0.1080mm)))

    (rule "DDR3_ADDR_50_OHM_OUTER"
        (layer outer)
        (condition "(A.NetClass == 'DDR3_ADDR' || A.NetClass == 'DDR3_OTHER') && A.NetName != '/DRAM/SRST'")
        (constraint track_width (min 0.0900mm) (opt 0.1072mm) (max 0.1080mm)))

    (rule "DDR3_DATA_50_OHM_IN2"
        (layer "In2.Cu")
        (condition "A.NetClass == 'DDR3_DATA_LB' || A.NetClass == 'DDR3_DATA_HB'")
        (constraint track_width (min 0.0900mm) (opt 0.1064mm) (max 0.1080mm)))

    (rule "DDR3_ADDR_50_OHM_IN2"
        (layer "In2.Cu")
        (condition "A.NetClass == 'DDR3_ADDR' || A.NetClass == 'DDR3_OTHER'")
        (constraint track_width (min 0.0900mm) (opt 0.1064mm) (max 0.1080mm)))

    (rule "DDR3_DATA_50_OHM_IN5"
        (layer "In5.Cu")
        (condition "A.NetClass == 'DDR3_DATA_LB' || A.NetClass == 'DDR3_DATA_HB'")
        (constraint track_width (min 0.0900mm) (opt 0.1064mm) (max 0.1080mm)))

    (rule "DDR3_ADDR_50_OHM_IN5"
        (layer "In5.Cu")
        (condition "A.NetClass == 'DDR3_ADDR' || A.NetClass == 'DDR3_OTHER'")
        (constraint track_width (min 0.0900mm) (opt 0.1064mm) (max 0.1080mm)))

    # 2. ІМПЕДАНС 100 Ом Differential (SCKP/N, SDQS0P/N, SDQS1P/N)
    (rule "DDR3_100_OHM_DIFF_OUTER"
        (layer outer)
        (condition "A.NetClass == 'DDR3_DIFF'")
        (constraint track_width (min 0.0900mm) (opt 0.1021mm) (max 0.1075mm))
        (constraint diff_pair_gap (min 0.1000mm) (opt 0.3299mm) (max 0.8500mm)))

    (rule "DDR3_100_OHM_DIFF_IN2"
        (layer "In2.Cu")
        (condition "A.NetClass == 'DDR3_DIFF'")
        (constraint track_width (min 0.0900mm) (opt 0.1029mm) (max 0.1075mm))
        (constraint diff_pair_gap (min 0.1000mm) (opt 0.3099mm) (max 0.8500mm)))

    (rule "DDR3_100_OHM_DIFF_IN5"
        (layer "In5.Cu")
        (condition "A.NetClass == 'DDR3_DIFF'")
        (constraint track_width (min 0.0900mm) (opt 0.1029mm) (max 0.1075mm))
        (constraint diff_pair_gap (min 0.1000mm) (opt 0.3099mm) (max 0.8500mm)))

    # 3. ІМПЕДАНС 90 Ом Differential (USB: D+ / D-)
    (rule "USB_90_OHM_DIFF_OUTER"
        (layer outer)
        (condition "A.NetClass == 'USB'")
        (constraint track_width (min 0.0900mm) (opt 0.1021mm) (max 0.1050mm))
        (constraint diff_pair_gap (min 0.1200mm) (opt 0.1400mm) (max 0.2500mm)))

    (rule "USB_90_OHM_DIFF_IN2"
        (layer "In2.Cu")
        (condition "A.NetClass == 'USB'")
        (constraint track_width (min 0.0900mm) (opt 0.1046mm) (max 0.1060mm))
        (constraint diff_pair_gap (min 0.1200mm) (opt 0.1300mm) (max 0.2500mm)))

    (rule "USB_90_OHM_DIFF_IN5"
        (layer "In5.Cu")
        (condition "A.NetClass == 'USB'")
        (constraint track_width (min 0.0900mm) (opt 0.1046mm) (max 0.1060mm))
        (constraint diff_pair_gap (min 0.1200mm) (opt 0.1300mm) (max 0.2500mm)))

    # 4. ЗАХИСТ ВІД ТРАСУВАННЯ DDR3 НА ОПОРНИХ ШАРАХ (In1, In3, In4, In6)
    (rule "DDR3_DISALLOW_IN1_REF"
        (layer "In1.Cu")
        (condition "A.NetName == '/DRAM/*'")
        (constraint disallow track))

    (rule "DDR3_DISALLOW_IN3_REF"
        (layer "In3.Cu")
        (condition "A.NetName == '/DRAM/*'")
        (constraint disallow track))

    (rule "DDR3_DISALLOW_IN4_REF"
        (layer "In4.Cu")
        (condition "A.NetName == '/DRAM/*'")
        (constraint disallow track))

    (rule "DDR3_DISALLOW_IN6_REF"
        (layer "In6.Cu")
        (condition "A.NetName == '/DRAM/*'")
        (constraint disallow track))

    # 5. ВИРІВНЮВАННЯ ЗАТРИМОК DDR3 (у пікосекундах ps)
    (rule "DDR3_DIFF_SKEW_CLK"
        (condition "A.NetName == '/DRAM/SCK*'")
        (constraint skew (max 1.5ps)))

    (rule "DDR3_DIFF_SKEW_DQS0"
        (condition "A.NetName == '/DRAM/SDQS0*'")
        (constraint skew (max 1.5ps)))

    (rule "DDR3_DIFF_SKEW_DQS1"
        (condition "A.NetName == '/DRAM/SDQS1*'")
        (constraint skew (max 1.5ps)))

    # Молодший байт пам'яті (DQ0..DQ7 + строб SDQS1P/N + маска SDQM1 -> ~205.9 ps)
    (rule "DDR3_BYTE_LB_LANE_SKEW"
        (condition "(A.NetClass == 'DDR3_DATA_LB' && A.NetName != '/DRAM/SDQM0') || A.NetName == '/DRAM/SDQS1*' || A.NetName == '/DRAM/SDQM1'")
        (constraint skew (max 12ps)))

    # Старший байт пам'яті (DQ8..DQ15 + строб SDQS0P/N + маска SDQM0 -> ~157.8 ps)
    (rule "DDR3_BYTE_HB_LANE_SKEW"
        (condition "(A.NetClass == 'DDR3_DATA_HB' && A.NetName != '/DRAM/SDQM1') || A.NetName == '/DRAM/SDQS0*' || A.NetName == '/DRAM/SDQM0'")
        (constraint skew (max 12ps)))

    # Адреси, банки, команди та керування відносно тактової пари SCKP/SCKN (~237 ps)
    (rule "DDR3_ADDR_CMD_CTRL_SKEW"
        (condition "A.NetClass == 'DDR3_ADDR' || A.NetName == '/DRAM/SCK*' || A.NetName == '/DRAM/SBA*' || A.NetName == '/DRAM/SRAS' || A.NetName == '/DRAM/SCAS' || A.NetName == '/DRAM/SWE' || A.NetName == '/DRAM/SCS*' || A.NetName == '/DRAM/SCKE*' || A.NetName == '/DRAM/SODT*'")
        (constraint skew (max 35ps)))

