#VRML V2.0 utf8
# AP6256 12x12mm WiFi/BT Module
Group {
  children [
    # PCB Substrate
    Transform {
      translation 0 0 0.2
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.05 0.25 0.1
              specularColor 0.1 0.1 0.1
              shininess 0.2
            }
          }
          geometry Box {
            size 12.0 12.0 0.4
          }
        }
      ]
    }
    # Metal Shielding Can
    Transform {
      translation 0 0 0.95
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.82 0.83 0.85
              specularColor 0.9 0.9 0.9
              ambientIntensity 0.3
              shininess 0.85
            }
          }
          geometry Box {
            size 11.2 11.2 1.1
          }
        }
      ]
    }
    # Pin 1 Marker (Laser engraved dot)
    Transform {
      translation -4.5 4.5 1.51
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.4 0.4 0.4
            }
          }
          geometry Cylinder {
            radius 0.4
            height 0.02
          }
        }
      ]
    }
  ]
